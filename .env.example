# Copy to .env and fill in. Never commit .env.

# Port the API (and the built client) listens on.
PORT=3535

# Where agastya.db lives. Defaults to ./data.
# AGASTYA_DATA_DIR=./data

# First-run bootstrap of the single Software Administrator. Used only while no
# administrator exists; ignored afterwards. The password must meet the policy
# (8-128 characters, not a common password) and must be changed at first sign-in.
# Choose a strong one-off value; never reuse a sample from documentation.
AGASTYA_INITIAL_ADMIN_USERNAME=admin
AGASTYA_INITIAL_ADMIN_PASSWORD=

# Set to 1 to mark the session cookie Secure unconditionally.
# AGASTYA_SECURE_COOKIES=1

# Set to 1 only when a TLS-terminating reverse proxy sits in front of the
# server, so req.secure reflects X-Forwarded-Proto. Client IPs for rate
# limiting are always taken from the socket, never from headers.
# AGASTYA_TRUST_PROXY=1

# ---- Backups (Phase 5; README section 12, docs/production.md) -----------------
# Where backups are kept. Default: <data folder>-backups beside the data folder.
# Use another disk if you can; it must not be inside the data folder. Restrict
# the folder to the account the server runs as.
# AGASTYA_BACKUP_DIR=D:\AgastyaBackups

# One backup a day at this time (HH:MM, 24-hour, server time). Off when unset.
# AGASTYA_BACKUP_SCHEDULE=02:30

# How many scheduled backups to keep (1 to 1000). Default 14.
# AGASTYA_BACKUP_KEEP=14

# Encrypts every backup (AES-256-GCM). 32 random bytes as 64 hex characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy OUTSIDE this machine and OUTSIDE the backups (a password manager
# or a sealed envelope): without it an encrypted backup cannot be restored.
# Never put a real key in this example file or in any committed file.
# AGASTYA_BACKUP_KEY=
